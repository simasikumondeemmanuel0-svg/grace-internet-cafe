Content-Transfer-Encoding: binary
Content-Location: cid:css-5e6ef0de-c5fb-4f8d-b86d-e825e6890712@mhtml.blink

@charset "utf-8";

:root { --navy: #062b55; --blue: #0878f9; --gold: #ffc629; --pale: #f1f7ff; --ink: #152b45; --muted: #5d6d80; --white: #fff; --green: #16a765; }

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body { margin: 0px; font-family: system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif; color: var(--ink); background: rgb(247, 250, 255); line-height: 1.55; }

a { color: inherit; text-decoration: none; }

button, input, select, textarea { font: inherit; }

button, .btn { border: 0px; border-radius: 12px; padding: 12px 17px; font-weight: 750; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; gap: 8px; transition: 0.2s; }

button:hover, .btn:hover { transform: translateY(-1px); filter: brightness(0.98); }

.btn-gold { background: var(--gold); color: rgb(20, 38, 59); }

.btn-blue { background: var(--blue); color: rgb(255, 255, 255); }

.btn-green { background: var(--green); color: rgb(255, 255, 255); }

.btn-outline { border: 1px solid rgb(199, 216, 238); background: rgb(255, 255, 255); color: var(--navy); }

.container { width: min(1120px, 92%); margin: auto; }

.topbar { background: var(--navy); color: rgb(255, 255, 255); position: sticky; top: 0px; z-index: 20; box-shadow: rgba(6, 27, 53, 0.125) 0px 5px 20px; }

.nav { display: flex; align-items: center; justify-content: space-between; gap: 18px; min-height: 72px; }

.brand { display: flex; align-items: center; gap: 10px; font-weight: 900; font-size: 1.3rem; line-height: 1.05; }

.brand-icon { font-size: 2rem; color: rgb(96, 184, 255); }

.brand span small { display: block; color: var(--gold); font-size: 0.8rem; }

.navlinks { display: flex; gap: 22px; align-items: center; font-size: 0.93rem; }

.navlinks a:hover { color: var(--gold); }

.menu { display: none; background: transparent; color: rgb(255, 255, 255); font-size: 1.4rem; padding: 7px; }

.hero { color: rgb(255, 255, 255); background: linear-gradient(90deg, rgba(3, 29, 60, 0.937) 0%, rgba(6, 43, 85, 0.85) 44%, rgba(6, 43, 85, 0.19) 100%), url("https://images.unsplash.com/photo-1498050108023-c5249f4df085?auto=format&fit=crop&w=1800&q=85") center center / cover; min-height: 430px; display: flex; align-items: center; }

.hero-inner { padding: 68px 0px; max-width: 650px; }

.eyebrow { color: var(--gold); font-weight: 800; text-transform: uppercase; letter-spacing: 0.12em; font-size: 0.8rem; }

.hero h1 { font-size: clamp(2.2rem, 5vw, 4rem); line-height: 1.05; margin: 12px 0px; }

.hero h1 em { font-style: normal; color: var(--gold); }

.hero p { font-size: 1.1rem; max-width: 540px; color: rgb(237, 245, 255); }

.actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 24px; }

.quickbar { background: rgb(255, 255, 255); box-shadow: rgba(8, 43, 85, 0.063) 0px 8px 25px; border-radius: 18px; margin-top: -28px; position: relative; display: grid; grid-template-columns: repeat(5, 1fr); padding: 20px 8px; }

.quick { padding: 8px 12px; text-align: center; border-right: 1px solid rgb(220, 232, 246); }

.quick:last-child { border: 0px; }

.quick .ico { font-size: 1.7rem; color: var(--blue); }

.quick strong { display: block; color: var(--navy); font-size: 0.9rem; }

.quick small { color: var(--muted); font-size: 0.78rem; }

.section { padding: 58px 0px; }

.section-head { display: flex; justify-content: space-between; align-items: end; gap: 20px; margin-bottom: 24px; }

.section h2 { font-size: clamp(1.65rem, 3vw, 2.25rem); line-height: 1.15; margin: 0px 0px 7px; color: var(--navy); }

.section-head p, .muted { color: var(--muted); margin: 0px; }

.services-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 15px; }

.service-card { background: rgb(255, 255, 255); border: 1px solid rgb(224, 235, 248); border-radius: 16px; padding: 22px; box-shadow: rgba(9, 44, 84, 0.063) 0px 8px 24px; }

.service-card .ico { font-size: 1.9rem; color: var(--blue); }

.service-card h3 { margin: 9px 0px 4px; font-size: 1.02rem; }

.price { font-weight: 850; color: var(--navy); font-size: 1.1rem; }

.service-card p { color: var(--muted); font-size: 0.87rem; margin: 5px 0px 0px; }

.booking-layout { display: grid; grid-template-columns: 1fr 0.82fr; gap: 24px; align-items: start; }

.panel { background: rgb(255, 255, 255); border: 1px solid rgb(222, 235, 249); border-radius: 20px; padding: 25px; box-shadow: rgba(9, 44, 84, 0.05) 0px 10px 30px; }

.form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }

.field { display: flex; flex-direction: column; gap: 6px; }

.field.full { grid-column: 1 / -1; }

.field label { font-size: 0.88rem; font-weight: 750; }

.field input, .field select, .field textarea { width: 100%; border: 1px solid rgb(204, 220, 237); border-radius: 10px; padding: 12px; background: rgb(255, 255, 255); color: var(--ink); }

.field textarea { min-height: 95px; resize: vertical; }

.field input:focus, .field select:focus, .field textarea:focus { outline: rgb(168, 208, 255) solid 2px; border-color: var(--blue); }

.note { font-size: 0.82rem; color: var(--muted); background: var(--pale); border-radius: 10px; padding: 12px; }

.steps { display: grid; gap: 14px; }

.step { display: flex; gap: 13px; align-items: flex-start; }

.stepnum { background: rgb(228, 240, 255); color: var(--blue); width: 38px; height: 38px; border-radius: 50%; display: grid; place-items: center; font-weight: 900; flex-shrink: 0; }

.gallery { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }

.gallery img { width: 100%; height: 220px; object-fit: cover; border-radius: 15px; border: 1px solid rgb(220, 232, 246); }

.payment-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; }

.payment { padding: 18px 10px; text-align: center; background: rgb(255, 255, 255); border: 1px solid rgb(224, 235, 248); border-radius: 14px; font-weight: 750; }

.payment span { display: block; font-size: 1.7rem; margin-bottom: 7px; }

.account-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }

.account-card { background: rgb(255, 255, 255); border: 1px solid rgb(220, 232, 246); border-radius: 18px; padding: 22px; }

.account-card h3 { margin-top: 0px; }

.account-card form { display: grid; gap: 12px; }

.account-card input { padding: 11px; border: 1px solid rgb(204, 220, 237); border-radius: 10px; }

.gallery-note { margin-top: 10px; }

.footer { background: rgb(3, 29, 59); color: rgb(255, 255, 255); padding: 40px 0px 20px; }

.footer-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 30px; }

.footer h3 { color: var(--gold); margin-top: 0px; }

.footer p, .footer a { color: rgb(213, 229, 246); font-size: 0.9rem; }

.footer-links { display: grid; gap: 7px; }

.copyright { border-top: 1px solid rgba(255, 255, 255, 0.19); margin-top: 26px; padding-top: 16px; color: rgb(182, 201, 223); font-size: 0.82rem; display: flex; justify-content: space-between; gap: 15px; flex-wrap: wrap; }

.toast { position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%); background: rgb(16, 43, 73); color: rgb(255, 255, 255); padding: 14px 20px; border-radius: 12px; box-shadow: rgba(0, 0, 0, 0.2) 0px 8px 25px; display: none; z-index: 50; max-width: 90%; text-align: center; }

.modal-backdrop { position: fixed; inset: 0px; background: rgba(6, 26, 48, 0.667); display: none; place-items: center; padding: 18px; z-index: 40; }

.modal { background: rgb(255, 255, 255); border-radius: 18px; padding: 25px; width: min(460px, 100%); }

.modal-head { display: flex; justify-content: space-between; align-items: center; }

.close { background: rgb(237, 244, 252); padding: 7px 11px; }

.small { font-size: 0.8rem; color: var(--muted); }

@media (max-width: 850px) {
  .navlinks { display: none; position: absolute; top: 72px; left: 0px; right: 0px; background: var(--navy); padding: 18px 5%; flex-direction: column; align-items: stretch; gap: 14px; }
  .navlinks.open { display: flex; }
  .menu { display: block; }
  .quickbar { grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .quick:nth-child(3) { border-right: 0px; }
  .quick:nth-child(4), .quick:nth-child(5) { border-top: 1px solid rgb(220, 232, 246); padding-top: 14px; }
  .services-grid { grid-template-columns: repeat(2, 1fr); }
  .booking-layout { grid-template-columns: 1fr; }
  .gallery img { height: 170px; }
  .payment-grid { grid-template-columns: repeat(3, 1fr); }
  .footer-grid { grid-template-columns: 1fr 1fr; }
  .footer-grid > div:first-child { grid-column: 1 / -1; }
}

@media (max-width: 520px) {
  .hero { min-height: 430px; }
  .hero-inner { padding: 54px 0px; }
  .hero p { font-size: 1rem; }
  .actions .btn { width: 100%; }
  .quickbar { grid-template-columns: repeat(2, 1fr); margin-top: -20px; }
  .quick { border-right: 0px; border-bottom: 1px solid rgb(220, 232, 246); }
  .quick:last-child { grid-column: 1 / -1; border-bottom: 0px; }
  .quick:nth-child(3) { border-bottom: 1px solid rgb(220, 232, 246); }
  .section { padding: 42px 0px; }
  .section-head { display: block; }
  .services-grid { grid-template-columns: 1fr 1fr; gap: 10px; }
  .service-card { padding: 15px; }
  .service-card h3 { font-size: 0.94rem; }
  .form-grid { grid-template-columns: 1fr; }
  .field.full { grid-column: auto; }
  .panel { padding: 18px; }
  .gallery { grid-template-columns: 1fr 1fr; }
  .gallery img { height: 140px; }
  .payment-grid { grid-template-columns: repeat(2, 1fr); }
  .account-grid, .footer-grid { grid-template-columns: 1fr; }
  .footer-grid > div:first-child { grid-column: auto; }
  .copyright { display: block; }
  .copyright span { display: block; margin-top: 7px; }
}
